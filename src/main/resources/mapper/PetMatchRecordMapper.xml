<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ynu.pet.mapper.PetMatchRecordMapper">

    <resultMap id="PetMatchRecordResultMap" type="ynu.pet.entity.PetMatchRecord">
        <id property="id" column="id"/>
        <result property="lostPostId" column="lost_post_id"/>
        <result property="queryImageUrl" column="query_image_url"/>
        <result property="matchedPetId" column="matched_pet_id"/>
        <result property="similarity" column="similarity"/>
        <result property="confidenceLevel" column="confidence_level"/>
        <result property="modelVersion" column="model_version"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="ynu.pet.entity.PetMatchRecord">
        INSERT INTO pet_match_record(
            lost_post_id, query_image_url, matched_pet_id, similarity, confidence_level, model_version
        )
        VALUES(
            #{lostPostId}, #{queryImageUrl}, #{matchedPetId}, #{similarity}, #{confidenceLevel}, #{modelVersion}
        )
    </insert>

    <delete id="deleteByLostPostId" parameterType="long">
        DELETE FROM pet_match_record
        WHERE lost_post_id = #{lostPostId}
    </delete>

    <select id="selectByLostPostId" parameterType="long" resultMap="PetMatchRecordResultMap">
        SELECT *
        FROM pet_match_record
        WHERE lost_post_id = #{lostPostId}
        ORDER BY similarity DESC, created_at DESC
    </select>
</mapper>
